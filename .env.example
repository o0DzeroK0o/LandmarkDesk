# Choose openai or anthropic. Use the API base including /v1.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Optional output budget. Anthropic defaults to 8192, OpenAI uses its server default.
AI_MAX_TOKENS=

# Provide one or both job URLs, e.g. https://cvat.example.org/tasks/12/jobs/34
CVAT_POSE_URL=
CVAT_FACE_URL=
